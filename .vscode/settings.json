{
    // IntelliSense gets flags and include paths straight from CMake Tools for the
    // active preset, so it works with the Visual Studio generator (which cannot
    // write compile_commands.json).
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // Fallback for files CMake Tools doesn't know about yet (e.g. a new .cpp before reconfiguring).
    "C_Cpp.default.cppStandard": "c++23",

    // Format with the repo's .clang-format, using the clang-format shipped with
    // Visual Studio 2026 (22.x) so the result matches the version STYLE.md was checked with.
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "none",
    "C_Cpp.clang_format_path": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Tools\\Llvm\\x64\\bin\\clang-format.exe",

    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },

    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
}
